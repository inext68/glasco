{
  "name": "glasco/association-manager",
  "description": "Laravel app for association management with persons, contacts, groups, associations, dioceses, roles and media.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "jeroennoten/laravel-adminlte": "^3.16",
    "intervention/image": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "classmap": [
      "database/seeders/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""]
  },
  "require-dev": {
    "laravel/boost": "^1.8",
    "laravel/breeze": "^1.29"
  }
}
